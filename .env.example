# Copy to .env when running Minecraft-Guard manually.
ABUSEIPDB_API_KEY=
MINECRAFT_GUARD_ADMIN_PASSWORD_HASH=
MINECRAFT_GUARD_WORKDIR=/opt/minecraft-guard
MINECRAFT_GUARD_WEB=1
MINECRAFT_GUARD_WEB_HOST=127.0.0.1
MINECRAFT_GUARD_WEB_PORT=8080
MINECRAFT_GUARD_SESSION_TTL=3600
MINECRAFT_GUARD_PORT=25565
MINECRAFT_GUARD_SCAN_INTERVAL=5
MINECRAFT_GUARD_ABUSE_THRESHOLD=75
MINECRAFT_GUARD_IPTABLES_CHAIN=MINECRAFT_GUARD
